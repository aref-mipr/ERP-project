@page
@model ERP.Presentation.Pages.FinancialTransaction.IndexModel
@{
    int counter = 1;
}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">لیست تراکنش ها</h4>
    </div>
    <div class="d-flex justify-content-start mb-4">

        <partial name="_Search" model="Model.Search" />

    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">تراکنش ها</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد:  @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-5">ردیف</th>
                        <th>نوع تراکنش</th>
                        <th>مبلغ تراکنش</th>
                        <th>زمان تراکنش</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FinancialTransactions)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@counter</td>
                            <td class="text-muted">@item.TransactionType</td>
                            @if(item.Amount >= 0)
                            {
                                <td class="text-success fw-bold">@item.Amount.ToString("N0")</td>
                            }
                            else
                            {
                                <td class="text-danger fw-bold">@item.Amount.ToString("N0")</td>
                            }

                            <td>@item.TransactionTime</td>
                            <td class="text-end pe-1">
                                <button class="table-action">
                                    <a asp-page="Details" asp-route-id="@item.Id">

                                        <i class="bi bi-eye"></i>

                                    </a>
                                </button>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="Model.Search" />
</div>