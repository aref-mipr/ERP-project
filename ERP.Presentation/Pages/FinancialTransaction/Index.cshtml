@page
@model ERP.Presentation.Pages.FinancialTransaction.IndexModel
@{
    int counter = 1;
}

<div class="container my-5">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">لیست تراکنش ها</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد تراکنش ها:  @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table dir="rtl" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-5">ردیف</th>
                        <th>نوع تراکنش</th>
                        <th>مبلغ تراکنش</th>
                        <th>زمان تراکنش</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.FinancialTransactions)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@counter</td>
                            <td class="text-muted">@item.TransactionType</td>
                            @if(item.FinancialTransactionsCriteria.Mount >= 0)
                            {
                                <td class="text-success fw-bold">@item.FinancialTransactionsCriteria.Mount.ToString("N0")</td>
                            }
                            else
                            {
                                <td class="text-danger fw-bold">@item.FinancialTransactionsCriteria.Mount.ToString("N0")</td>
                            }

                            <td>@item.TransactionTime</td>
                            <td class="text-end pe-1">
                                <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">جزئیات</a>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>