@page
@model ERP.Presentation.Pages.FinancialTransaction.BudgetsModel
@{
    int counter = 1;
}
<div class="container my-5">
    @if (TempData["Message"] != null)
    {
        <div id="message"  class="alert alert-success">
            @TempData["Message"]
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            @if (Model.Budgets == null)
            {
                <a asp-page="/Budget/Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg"></i> ثبت سرمایه اولیه
                </a>
            }
            else
            {
                <a asp-page="/Budget/Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg"></i> ثبت سرمایه جدید
                </a>
            }
        </div>
        <h4 class="fw-bold mb-0">لیست سرمایه های ثبت شده</h4>
    </div>

    <div class="d-flex justify-content-start mb-4">

        <partial name="_Search" model="Model.Search" />

    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">بودجه</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد: @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table  class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-5">ردیف</th>
                        <th>نوع سرمایه</th>
                        <th>مبلغ</th>
                        <th>تاریخ ثبت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Budgets)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@counter</td>
                            <td class="text-muted">@item.TransactionType</td>
                            <td class="text-success fw-bold">@item.Amount.ToString("N0")</td>
                            <td >@item.TransactionTime</td>
                            <td>
                                <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">جزئیات</a>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="Model.Search" />
</div>
<script src="~/js/timeout_for_alert.js"></script>