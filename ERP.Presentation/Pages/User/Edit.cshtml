@page
@model ERP.Presentation.Pages.User.EditModel
@{
}
<div class="container my-5" dir="rtl">

    @if (TempData["Message"] != null)
    {
        <div id="message" class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="row justify-content-center">

        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">

                <div class="card-header bg-white border-0 p-4">
                    <h4 class="fw-bold mb-0">
                        ویرایش کاربر
                    </h4>
                </div>

                <div class="card-body p-4">

                    <form method="post" enctype="multipart/form-data">

                        <!-- Full Name -->
                        <div class="row g-3 mb-3">

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    نام
                                </label>

                                <input asp-for="Command.UsersCriteria.FirstName" type="text"
                                       class="form-control"
                                       placeholder="نام">
                                <span asp-validation-for="Command.UsersCriteria.FirstName" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label fw-semibold">
                                    نام خانوادگی
                                </label>

                                <input asp-for="Command.UsersCriteria.LastName" type="text"
                                       class="form-control"
                                       placeholder="نام خانوادگی">
                                <span asp-validation-for="Command.UsersCriteria.LastName" class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Phone -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                شماره تماس
                            </label>

                            <input asp-for="Command.UsersCriteria.PhoneNumber" type="tel"
                                   class="form-control"
                                   placeholder="09123456789">
                            <span asp-validation-for="Command.UsersCriteria.PhoneNumber" class="text-danger"></span>


                        </div>

                        <!-- Username -->
                        <div class="mb-3">

                            <label class="form-label fw-semibold">
                                نام کاربری
                            </label>

                            <input asp-for="Command.UsersCriteria.UserName" type="text"
                                   class="form-control"
                                   placeholder="نام کاربری">
                            <span asp-validation-for="Command.UsersCriteria.UserName" class="text-danger"></span>


                        </div>

                        <!-- Password -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                رمز عبور
                            </label>

                            <input asp-for="Command.Password" type="password"
                                   class="form-control"
                                   placeholder="رمز عبور">
                            <span asp-validation-for="Command.Password" class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                تکرار رمز عبور
                            </label>

                            <input asp-for="RepeatPassword" type="password"
                                   class="form-control"
                                   placeholder="تکرار رمز عبور">
                            <span class="text-danger">@TempData["RepeatPassword"]</span>

                        </div>

                        <!-- Profile Image -->
                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                تصویر پروفایل
                                <span class="text-muted fw-normal">(اختیاری)</span>
                            </label>

                            <!-- Drop Zone -->
                            <label id="dropZone"
                                   class="border border-2 border-secondary-subtle rounded-4 p-5 text-center w-100 bg-light"
                                   style="border-style: dashed; cursor: pointer;">

                                <div id="dropIcon" class="mb-2 fs-1">
                                    📷
                                </div>

                                <div id="dropTitle" class="fw-semibold">
                                    تصویر را اینجا رها کنید
                                </div>

                                <div id="dropDescription" class="text-muted small mt-2">
                                    یا برای انتخاب فایل کلیک کنید
                                </div>

                                <input asp-for="Command.ImageFile" type="file"
                                       id="profileImage"
                                       class="d-none"
                                       accept="image/*">

                            </label>

                            <!-- Image File Name -->
                            <div class="mt-3">

                                <label class="form-label fw-semibold">
                                    نام فایل تصویر
                                </label>

                                <input type="text"
                                       id="profileImageName"
                                       name="ProfileImageName"
                                       class="form-control"
                                       placeholder="نام فایل تصویر پس از انتخاب نمایش داده می‌شود"
                                       readonly>

                            </div>

                        </div>
                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-2">

                            <a asp-page="Details" asp-route-id="@Model.Command.Id" class="btn btn-light border">
                                انصراف
                            </a>

                            <input type="hidden" asp-for="Command.Id"/>

                            <button type="submit"
                                    class="btn btn-primary px-4">
                                ویرایش
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

<script src="~/js/drag&drop.js"></script>