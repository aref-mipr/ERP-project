@page
@model ERP.Presentation.Pages.User.DetailsModel
@{
}
<div class="container" dir="rtl">
    @if (TempData["Message"] != null)
    {
        <div id="message" class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="profile-card">

        <!-- Header -->
        <div class="profile-header">

            <div class="profile-avatar-wrapper">

                <img src="/images/profile/@Model.User.UsersCriteria.ProfilePicture"
                     alt="تصویر پروفایل"
                     class="profile-avatar">

            </div>

        </div>


        <!-- Body -->
        <div class="profile-body">

            <!-- User Name -->
            <div class="text-center mb-4">

                <h3 class="fw-bold mb-1">
                    @Model.User.FullName
                </h3>

                <div class="text-muted">
                    @Model.User.UsersCriteria.UserName
                </div>

            </div>


            <!-- Information -->
            <div class="row g-3">

                <!-- First Name -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <div class="profile-info-label">
                            نام
                        </div>

                        <div class="profile-info-value">
                            @Model.User.UsersCriteria.FirstName
                        </div>

                    </div>

                </div>


                <!-- Last Name -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <div class="profile-info-label">
                            نام خانوادگی
                        </div>

                        <div class="profile-info-value">
                            @Model.User.UsersCriteria.LastName
                        </div>

                    </div>

                </div>


                <!-- Username -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <div class="profile-info-label">
                            نام کاربری
                        </div>

                        <div class="profile-info-value">
                            @Model.User.UsersCriteria.UserName
                        </div>

                    </div>

                </div>


                <!-- Phone -->
                <div class="col-md-6">

                    <div class="profile-info">

                        <div class="profile-info-label">
                            شماره تماس
                        </div>
                        <div class="profile-info-value">
                            @Model.User.UsersCriteria.PhoneNumber
                        </div>

                    </div>

                </div>

            </div>


            <!-- Actions -->
            <div class="profile-actions">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                    <div class="text-muted small">
                        مدیریت حساب کاربری
                    </div>

                    <div class="d-flex gap-2">

                        <!-- Edit -->
                        <a asp-page="Edit" asp-route-id="@Model.User.Id"
                           class="btn btn-primary px-4">

                            ویرایش

                        </a>


                        <!-- Logout -->
                        <form method="post" id="logoutForm">

                            <button type="button"
                                    class="btn btn-outline-danger px-4"
                                    data-bs-toggle="modal"
                                    data-bs-target="#logoutModal">

                                خروج از حساب کاربری

                            </button>

                        </form>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
<!-- Logout Modal -->
<div class="modal fade"
     id="logoutModal"
     tabindex="-1"
     aria-labelledby="logoutModalLabel"
     aria-hidden="true"
     dir="rtl">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content border-0 rounded-4 shadow">

            <!-- Header -->
            <div class="modal-header border-0 p-4">

                <h5 class="modal-title fw-bold"
                    id="logoutModalLabel">

                    خروج از حساب کاربری

                </h5>

                <button type="button"
                        class="btn-close ms-0 me-auto"
                        data-bs-dismiss="modal"
                        aria-label="بستن">
                </button>

            </div>

            <!-- Body -->
            <div class="modal-body text-center px-4 pb-4">

                <div class="mb-3">

                    <div class="rounded-circle bg-danger bg-opacity-10
                        text-danger d-inline-flex
                        align-items-center justify-content-center"
                         style="width: 70px; height: 70px;">

                        <i class="bi bi-box-arrow-right fs-2"></i>

                    </div>

                </div>

                <h5 class="fw-semibold mb-2">
                    آیا می‌خواهید از حساب کاربری خود خارج شوید؟
                </h5>

                <p class="text-muted mb-4">
                    پس از خروج، برای استفاده مجدد از سیستم باید وارد حساب کاربری خود شوید.
                </p>

                <!-- Buttons -->
                <div class="d-flex justify-content-center gap-2">

                    <!-- No -->
                    <button type="button"
                            class="btn btn-light border px-4"
                            data-bs-dismiss="modal">

                        نه

                    </button>

                    <!-- Yes -->
                    <button type="button"
                            class="btn btn-danger px-4"
                            id="confirmLogout">

                        بله

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>
<script src="~/js/logout.js"></script>