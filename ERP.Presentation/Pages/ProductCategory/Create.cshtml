@page
@model ERP.Presentation.Pages.ProductCategory.CreateModel
@{
}

<div class="container my-5" >
    @if (TempData["Message"] != null)
    {
        <div id="message" class="alert alert-success">
            @TempData["Message"]
        </div>
    }
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h4 class="fw-bold mb-0">ایجاد دسته بندی جدید</h4>
                </div>

                <div class="card-body p-4">

                    <form method="post">
                        <div class="md-3">
                            <label asp-for="Command.ProductCategoryCriterias.Name" class="form-label fw-semibold">نام</label>
                            <input type="text" asp-for="Command.ProductCategoryCriterias.Name" class="form-control" />
                            <span asp-validation-for="Command.ProductCategoryCriterias.Name" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary px-4">ایجاد</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/js/timeout_for_alert.js"></script>