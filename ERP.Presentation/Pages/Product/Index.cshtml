@page
@model ERP.Presentation.Pages.Product.IndexModel
@{
    int counter = 1;
}
<div class="container my-5">
    @if (TempData["Message"] != null)
    {
        <div id="message"  class="alert alert-success">
            @TempData["Message"]
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> ایجاد محصول جدید
        </a>
        <h4 class="fw-bold mb-0">لیست محصولات</h4>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">دسته بندی ها</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد: @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-5">ردیف</th>
                        <th>کد محصول</th>
                        <th>نام</th>
                        <th>دسته بندی</th>
                        <th>قیمت تمام شده (ریال)</th>
                        <th>موجودی انبار</th>
                        <th>تاریخ ایحاد</th>
                        <th>لیست آیتم ها</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>
            
                <tbody>
                    @foreach (var item in Model.Products)
                    {
                            <tr>
                                <td class="ps-4 fw-semibold">@counter</td>
                                <td class="text-muted">@item.ProductCode</td>
                                <td>@item.Name</td>
                                <td>@item.ProductCategory</td>
                                <td class="text-success fw-bold">@item.CostPrice.ToString("N0")</td>
                                <td>@item.StockQuantity</td>
                                <td>@item.CreationTime</td>
                                <td>
                                    <select class="form-select sub-selector" data-parent-id="@item.Id">
                                        <option value="">-- انتخاب محصول --</option>
                                    </select>
                                </td>
            
                                <td class="text-end pe-1">
            
                                    <a asp-page="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-2">جزئیات</a>
                                    <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">ویرایش</a>
            
                                </td>
                            </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script src="~/js/product_item_dropdown.js"></script>
