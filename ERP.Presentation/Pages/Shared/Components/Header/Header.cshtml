@model ERP.Presentation.ViewModels.HeaderViewModel
@{
}
@if (Model.InitialCapital)
{
    <div id="sidebarOverlay" class="sidebar-overlay"></div>
    <header class="topbar">
        <div class="topbar-left">

            <button id="sidebarToggle" class="menu-btn">
                <i id="menuIcon" class="bi bi-list"></i>
            </button>

            <h2 class="page-title">
                @ViewData["PageTitle"]
            </h2>

            <div class="today-date">

                <i class="bi bi-calendar3"></i>

                <span>
                    @Model.DateNow
                </span>

            </div>

        </div>

        <div class="topbar-right">

            @if(Model.UserLogin != null)
            {
                <a asp-page="/User/Details" asp-route-id="@Model.UserLogin.Id" style="text-decoration:none;">
                    <div class="profile">
                        <div class="avatar">
                            @if (Model.UserLogin.UsersCriteria.ProfilePicture == null)
                            {
                                <i class="bi bi-person-fill"></i>
                            }
                            else
                            {
                                <img src="/images/profile/@Model.UserLogin.UsersCriteria.ProfilePicture" alt="Profile">
                            }
                        </div>

                        <div>

                            <div class="profile-name">
                                @Model.UserLogin.UsersCriteria.UserName
                            </div>

                            <small>
                                سییتم مدیریتی
                            </small>

                        </div>

                        <i class="bi bi-chevron-down"></i>

                    </div>
                </a>
            }

        </div>
    </header>
}



