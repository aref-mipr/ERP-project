@page
@model ERP.Presentation.Pages.Order.SelectProductItemModel
@{
}

@if (TempData["Message"] != null)
{
    <div id="message" dir="rtl" class="alert alert-danger">
        @TempData["Message"]
    </div>
}

<div class="container my-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h4 class="fw-bold mb-0">چند آیتم را انتخاب کنید</h4>
                </div>

                <div class="card-body p-4">

                    <form method="post" asp-route-id="@Model.Id">

                        <div class="list-group">

                                @foreach (var item in Model.ProductItems)
                                {

                                    <label class="list-group-item rounded-3 mb-3 border">
                                        <div class="d-flex justify-content-between align-items-center">

                                            <div>
                                                <div class="text-muted small">
                                                    کد آیتم:
                                                    <span class="fw-semibold text-dark">@item.ProductItemCode</span>
                                                </div>

                                                <div class="fw-semibold fs-5 mt-1">
                                                    @item.Name
                                                </div>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input fs-5" type="checkbox" name="ProductItemIds" value="@item.Id">
                                            </div>

                                        </div>
                                    </label>
                                }
                            </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                ادامه
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>