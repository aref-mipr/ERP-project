@page
@model ERP.Presentation.Pages.Order.SelectProductItemModel
@{
}

@if (TempData["Message"] != null)
{
    <div id="message"  class="alert alert-danger">
        @TempData["Message"]
    </div>
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h4 class="fw-bold mb-0">چند آیتم را انتخاب کنید</h4>
                </div>

                <div class="card-body p-4">

                    <form method="post" asp-route-id="@Model.Id">

                        <div class="list-group">

                                @foreach (var item in Model.ProductItems)
                                {

                                    <label class="list-group-item rounded-3 mb-3 border">
                                        <div class="d-flex justify-content-between align-items-center">

                                            <div>
                                                <div class="text-muted small">
                                                    کد آیتم:
                                                    <span class="fw-semibold text-dark">@item.ProductItemCode</span>
                                                </div>

                                                <div class="fw-semibold fs-5 mt-1">
                                                    @item.Name
                                                </div>
                                            </div>

                                            <div class="form-check">
                                                <input class="form-check-input fs-5" type="checkbox"
                                                name="ProductItemIds" value="@item.Id">
                                            </div>
                                        <script>

                                            document.addEventListener("DOMContentLoaded", function () {
                                            
                                                const storageKey = "selectedProductItemIds";
                                            
                                                let selectedIds =
                                                    JSON.parse(sessionStorage.getItem(storageKey) || "[]");
                                            
                                                selectedIds = selectedIds.map(String);
                                            
                                            
                                                // --------------------------------
                                                // اعمال انتخاب‌های قبلی روی صفحه
                                                // --------------------------------
                                            
                                                document
                                                    .querySelectorAll('input[name="ProductItemIds"]')
                                                    .forEach(function (checkbox) {
                                            
                                                        if (selectedIds.includes(checkbox.value)) {
                                                            checkbox.checked = true;
                                                        }
                                            
                                                    });
                                            
                                            
                                                // --------------------------------
                                                // تغییر checkbox
                                                // --------------------------------
                                            
                                                document
                                                    .querySelectorAll('input[name="ProductItemIds"]')
                                                    .forEach(function (checkbox) {
                                            
                                                        checkbox.addEventListener("change", function () {
                                            
                                                            const id = this.value;
                                            
                                                            if (this.checked) {
                                            
                                                                if (!selectedIds.includes(id)) {
                                                                    selectedIds.push(id);
                                                                }
                                            
                                                            }
                                                            else {
                                            
                                                                selectedIds =
                                                                    selectedIds.filter(x => x !== id);
                                            
                                                            }
                                            
                                                            sessionStorage.setItem(
                                                                storageKey,
                                                                JSON.stringify(selectedIds)
                                                            );
                                            
                                                        });
                                            
                                                    });
                                            
                                            
                                                // --------------------------------
                                                // قبل از Search
                                                // --------------------------------
                                            
                                                const searchForm =
                                                    document.getElementById("searchForm");
                                            
                                                if (searchForm) {
                                            
                                                    searchForm.addEventListener("submit", function () {
                                            
                                                        // حذف ProductItemIds قبلی
                                                        searchForm
                                                            .querySelectorAll(
                                                                'input[name="ProductItemIds"]'
                                                            )
                                                            .forEach(function (input) {
                                                                input.remove();
                                                            });
                                            
                                            
                                                        // اضافه کردن تمام انتخاب‌ها
                                                        selectedIds.forEach(function (id) {
                                            
                                                            const input =
                                                                document.createElement("input");
                                            
                                                            input.type = "hidden";
                                                            input.name = "ProductItemIds";
                                                            input.value = id;
                                            
                                                            searchForm.appendChild(input);
                                            
                                                        });
                                            
                                                    });
                                            
                                                }
                                            
                                            });

                                        </script>

                                        </div>
                                    </label>
                                }
                            </div>

                        <div class="d-flex justify-content-end mt-4">
                            <button type="submit" class="btn btn-primary px-4">
                                ادامه
                            </button>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>