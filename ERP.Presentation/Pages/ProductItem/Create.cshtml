@page
@model ERP.Presentation.Pages.ProductItem.CreateModel
@{
}
<div class="container my-5" >
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h4 class="fw-bold mb-0">ثبت آیتم جدید</h4>
                </div>

                <div class="card-body p-4">
                    <form method="post">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Command.ProductItemCriterias.Price" class="form-label fw-semibold">قیمت</label>
                                <input asp-for="Command.ProductItemCriterias.Price" type="number" class="form-control" placeholder="مثلا 10000000">
                                <span asp-validation-for="Command.ProductItemCriterias.Price" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label asp-for="Command.ProductItemCriterias.Description" class="form-label fw-semibold">توضیحات</label>
                            <textarea asp-for="Command.ProductItemCriterias.Description" class="form-control" rows="3" placeholder="توضیحات محصول"></textarea>
                        </div>
                        <input type="hidden" asp-for="Command.ProductItemCriterias.ProductId" />
                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary px-4">ثبت</button>
                        </div>

                    </form>
                </div>

            </div>

        </div>
    </div>
</div>
