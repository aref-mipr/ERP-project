@page
@model ERP.Presentation.Pages.Budget.IndexModel
@{
    int counter = 1;
}
<div class="container my-5">
    @if (TempData["Message"] != null)
    {
        <div id="message" dir="rtl" class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            @if (Model.Budgets == null)
            {
                <a asp-page="Create" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg"></i> ثبت سرمایه اولیه
                </a>
            }
            else
            {
                <a asp-page="WithDrawal" class="btn btn-primary shadow-sm">
                    <i class="bi bi-plus-lg"></i> برداشت از سرمایه کل
                </a>
            }
            <a asp-page="/FinancialTransaction/Budgets" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg"></i>  سرمایه های ثبت شده
            </a>
        </div>
        <h4 class="fw-bold mb-0">لیست تغییرات بودجه</h4>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">بودجه</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد: @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table dir="rtl" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-5">ردیف</th>
                        <th>مبلغ تغییر</th>
                        <th>مبلغ نهایی</th>
                        <th>تاریخ ثبت</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Budgets)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@counter</td>
                            @if(item.ChangeMount >= 0)
                            {
                                <td class="text-success fw-bold">@item.ChangeMount.ToString("N0")</td>
                            }
                            else
                            {
                                <td class="text-danger fw-bold">@item.ChangeMount.ToString("N0")</td>
                            }
                            <td class="text-success fw-bold">@item.TotalBudget.ToString("N0")</td>
                            <td>@item.LastUpdate</td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
