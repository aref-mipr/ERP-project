@page
@model ERP.Presentation.Pages.SideExpense.DetailsModel
@{
}
<div class="card shadow-sm border-0 rounded-4 mb-4" dir="rtl">

    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold mb-0">جزئیات هزینه جانبی</h4>
        <a asp-page="Edit" asp-route-id="@Model.SideExpense.Id" class="btn btn-primary">
            ویرایش
        </a>
    </div>

    <div class="card-body p-4">

        <div class="row g-3">

            <div class="col-lg-8">
                <div class="border rounded-3 p-3 h-100 bg-light">

                    <small class="text-muted">
                        عنوان هزینه
                    </small>

                    <div class="fw-semibold fs-4 mt-2">
                        @Model.SideExpense.Title
                    </div>

                </div>
            </div>

            <div class="col-lg-4">
                <div class="rounded-3 p-3 h-100 bg-danger bg-opacity-10 border border-danger">

                    <small class="text-danger">
                        مبلغ هزینه
                    </small>

                    <div class="display-6 fw-bold text-danger mt-2">
                        @Model.SideExpense.Amount.ToString("N0")
                    </div>

                    <small class="text-danger">
                        ریال
                    </small>

                </div>
            </div>

            <div class="col-12">
                <div class="border rounded-3 p-3">

                    <small class="text-muted">
                        تاریخ ثبت هزینه
                    </small>

                    <div class="fw-semibold fs-5 mt-2">
                        @Model.SideExpense.ExpenseRecordingTime
                    </div>

                </div>
            </div>

        </div>

        <div class="mt-4">

            <label class="form-label fw-semibold">
                توضیحات
            </label>
            @if (Model.SideExpense.Description == null)
            {
                <div class="border rounded-3 bg-light p-3 text-secondary lh-lg">

                    توضیحاتی برای این هزینه ثبت نشده

                </div>
            }
            else
            {
                <div class="border rounded-3 bg-light p-3 text-secondary lh-lg">

                    @Model.SideExpense.Description

                </div>
            }

        </div>

    </div>

</div>