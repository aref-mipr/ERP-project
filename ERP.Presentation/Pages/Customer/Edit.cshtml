@page
@model ERP.Presentation.Pages.Customer.EditModel
@{
}
@if (TempData["Message"] != null)
{
    <div id="message" class="alert alert-danger">
        @TempData["Message"]
    </div>
}

<div class="container my-5" dir="rtl">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h4 class="fw-bold mb-0">ویرایش مشتری</h4>
                </div>

                <div class="card-body p-4">

                    <form method="post">
                        <div class="row g-3 mb-3">
                            <div class="md-6">
                            <label asp-for="Command.CustomerCriterias.FirstName" class="form-label fw-semibold">نام</label>
                            <input type="text" asp-for="Command.CustomerCriterias.FirstName" class="form-control" />
                            <span asp-validation-for="Command.CustomerCriterias.FirstName" class="text-danger"></span>
                        </div>
                            <div class="md-6">
                            <label asp-for="Command.CustomerCriterias.LastName" class="form-label fw-semibold"> نام خانوادگی</label>
                            <input type="text" asp-for="Command.CustomerCriterias.LastName" class="form-control" />
                            <span asp-validation-for="Command.CustomerCriterias.LastName" class="text-danger"></span>
                        </div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="md-6">
                            <label asp-for="Command.CustomerCriterias.Phone" class="form-label fw-semibold">شماره همراه</label>
                            <input type="text" asp-for="Command.CustomerCriterias.Phone" class="form-control" />
                            <span asp-validation-for="Command.CustomerCriterias.Phone" class="text-danger"></span>
                        </div>
                            <div class="md-6">
                            <label asp-for="Command.CustomerCriterias.Email" class="form-label fw-semibold">ایمیل</label>
                            <input type="text" asp-for="Command.CustomerCriterias.Email" class="form-control" />
                            <span asp-validation-for="Command.CustomerCriterias.Email" class="text-danger"></span>
                        </div>
                        </div>

                        <input type="hidden" asp-for="Command.Id" />

                        <div class="d-flex justify-content-end gap-2">
                            <button type="submit" class="btn btn-primary px-4">ثبت</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>