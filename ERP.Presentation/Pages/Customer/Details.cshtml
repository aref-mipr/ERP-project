@page
@model ERP.Presentation.Pages.Customer.DetailsModel
@{
    int counter = 1;
}

<div class="container my-5" >

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">اطلاعات مشتری</h4>
            <a asp-page="Edit" asp-route-id="@Model.Customer.Id" class="btn btn-primary">
                ویرایش
            </a>
        </div>
        
        
        <div class="card-body p-4">
        
            <div class="d-flex align-items-center mb-4">
                <div>
                    <h5 class="mb-0 fw-bold">@Model.Customer.FullName</h5>
                </div>
            </div>
            <div class="row g-3">
            
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <small class="text-muted">شماره تماس</small>
                        <div class="fw-semibold">@Model.Customer.Phone</div>
                    </div>
                </div>
            
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <small class="text-muted">ایمیل</small>
                        <div class="fw-semibold">@Model.Customer.Email</div>
                    </div>
                </div>
            
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <small class="text-muted">تاریخ ثبت</small>
                        <div class="fw-semibold">@Model.Customer.CreationTime</div>
                    </div>
                </div>
            
            </div>
        </div>
    </div>
</div>

<div class="container my-5">
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">


        </div>
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">سفارش های این مشتری</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد: @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table  class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <tr>
                            <th class="ps-5">ردیف</th>
                            <th>کد سفارش</th>
                            <th>مبلغ سفارش</th>
                            <th>تاریخ ثبت</th>
                            <th>وضعیت</th>
                            <th>آیتم ها</th>
                            <th class="text-end pe-4">عملیات</th>
                        </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Orders)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@counter</td>
                            <td>@item.OrderCode</td>
                                <td class="text-success fw-bold">@item.FinalAmount</td>
                            <td>@item.CreationTime</td>
                            <td>@item.OrderStatus</td>
                            <td>
                                <select class="form-select sub-selector" data-parent-id="@item.Id">
                                    <option value="">-- انتخاب محصول --</option>
                                </select>
                            </td>
                            <td class="text-end pe-1">
                                <button class="table-action">
                                    <a asp-page="/Order/Details" asp-route-id="@item.Id">
                                
                                        <i class="bi bi-eye"></i>
                                
                                    </a>
                                </button>
                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
    <script src="~/js/order_item_dropdown.js"></script>