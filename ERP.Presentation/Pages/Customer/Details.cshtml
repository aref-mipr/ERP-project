@page
@model ERP.Presentation.Pages.Customer.DetailsModel
@{
}

<div class="container my-5" dir="rtl">

    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
            <h4 class="fw-bold mb-0">اطلاعات مشتری</h4>
            <a asp-page="Edit" asp-route-id="@Model.Customer.Id" class="btn btn-primary">
                ویرایش
            </a>
        </div>
        
        
        <div class="card-body p-4">
        
            <div class="d-flex align-items-center mb-4">
                <div>
                    <h5 class="mb-0 fw-bold">@Model.Customer.FullName</h5>
                </div>
            </div>
            <div class="row g-3">
            
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <small class="text-muted">شماره تماس</small>
                        <div class="fw-semibold">@Model.Customer.CustomerCriterias.Phone</div>
                    </div>
                </div>
            
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <small class="text-muted">ایمیل</small>
                        <div class="fw-semibold">@Model.Customer.CustomerCriterias.Email</div>
                    </div>
                </div>
            
                <div class="col-md-4">
                    <div class="border rounded-3 p-3 bg-light">
                        <small class="text-muted">تاریخ ثبت</small>
                        <div class="fw-semibold">@Model.Customer.CreationTime</div>
                    </div>
                </div>
            
            </div>
        </div>
    </div>
</div>

