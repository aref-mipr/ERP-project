@page
@model ERP.Presentation.Pages.Employee.DetailsModel
@{
}
<div class="card shadow-sm border-0 rounded-4 mb-4" dir="rtl">

    <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
        <h4 class="fw-bold mb-0">مشخصات کارمند</h4>
        <a asp-page="Edit" asp-route-id="@Model.Employee.Id" class="btn btn-primary">
            ویرایش
        </a>
    </div>

    <div class="card-body p-4">

        <div class="row g-3">

            <div class="col-md-4">
                <div class="border rounded-3 p-3 h-100 bg-light">
                    <small class="text-muted">کد پرسنلی</small>

                    <div class="fs-4 fw-bold text-primary">
                        #@Model.Employee.EmployeesCriteria.EmployeeCode
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded-3 p-3 h-100 bg-light">
                    <small class="text-muted">نام و نام خانوادگی</small>

                    <div class="fw-semibold fs-5">
                        @Model.Employee.FullName
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded-3 p-3 h-100 bg-light">
                    <small class="text-muted">سمت</small>

                    <div class="fw-semibold fs-5">
                        @Model.Employee.EmployeesCriteria.Position
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted">شماره تماس</small>

                    <div class="fs-5">
                        @Model.Employee.EmployeesCriteria.Phone
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted">حقوق ماهانه</small>

                    <div class="fs-4 fw-bold">
                        @Model.Employee.EmployeesCriteria.SalaryMonthly.ToString("N0")
                    </div>

                    <small class="text-secondary">
                        ریال
                    </small>
                </div>
            </div>

            <div class="col-md-4">
                <div class="rounded-3 p-3 h-100 bg-success bg-opacity-10 border border-success">

                    <small class="text-success">
                        وضعیت
                    </small>

                    <div class="mt-2">
                        <span class="badge @TempData["StatusStyle"] fs-6">
                                @Model.Employee.EmployeeStatus
                        </span>
                    </div>

                </div>
            </div>

            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">

                    <small class="text-muted">
                        تاریخ استخدام
                    </small>

                    <div class="fw-semibold fs-5">
                        @Model.Employee.CreationTime
                    </div>

                </div>
            </div>

            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">

                    <small class="text-muted">
                        آخرین پرداخت حقوق
                    </small>

                    <div class="fw-semibold fs-5">
                        @Model.Employee.LastSalaryPaymentTime
                    </div>

                </div>
            </div>

        </div>

        <div class="mt-4">

            <label class="form-label fw-semibold">
                توضیحات
            </label>

            <div class="border rounded-3 p-3 bg-light text-secondary">

                @Model.Employee.EmployeesCriteria.Description

            </div>

        </div>

    </div>

</div>