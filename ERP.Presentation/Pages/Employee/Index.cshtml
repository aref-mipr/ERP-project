@page
@model ERP.Presentation.Pages.Employee.IndexModel
@{
    int counter = 1;
}
<div class="container my-5">
    @if (TempData["Message"] != null)
    {
        <div id="message"  class="alert alert-success">
            @TempData["Message"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="message"  class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> ثبت کارمند جدید
        </a>
        <h4 class="fw-bold mb-0">لیست کارمندان</h4>
    </div>

    <div class="d-flex justify-content-start mb-4">

        <partial name="_Search" model="Model.Search" />

    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="card-header bg-white border-0 px-4 py-3">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold">کارمندان</h5>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">تعداد: @TempData["NumberItems"]</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-5">ردیف</th>
                        <th>کد کارمندی</th>
                        <th>نام و نام خانوادگی</th>
                        <th>شماره تماس</th>
                        <th>جایگاه</th>
                        <th>وضعیت</th>
                        <th>وضعیت پرداخت دستمزد</th>
                        <th>تغییر وضعیت</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Employees)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold">@counter</td>
                            <td class="text-muted">@item.EmployeeCode</td>
                            <td>@item.FullName</td>
                            <td>@item.Phone</td>
                            <td class="text-success fw-bold">@item.Position</td>
                            <td>
                                    @item.EmployeeStatus
                                
                            </td>
                            @if (item.EmployeeStatus == TempData["Active"] || item.EmployeeStatus == TempData["ReEmployment"])
                            {
                                <td>
                                @if(item.SalaryPayed == false)
                                {
                                    <a asp-page-handler="Payed" asp-route-id="@item.Id" class="btn btn-sm btn-outline-success">پرداخت دستمزد</a>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fs-6">پرداخت شده</span>
                                }
                                </td>
                                <td>
                                    <form method="post" asp-route-id="@item.Id">
                                        <select asp-for="Status" asp-items="Model.StatusesList" onchange="this.form.submit()" class="form-select sub-selector">
                                            <option value="">-- انتخاب وضعیت --</option>
                                        </select>
                                    </form>
                                </td>
                            }
                            else
                            {
                                <td>
                                    <span class="badge bg-warning text-dark fs-6">غیرقابل پرداخت</span>
                                </td>
                                <td>
                                    <form method="post" asp-route-id="@item.Id">
                                        <select asp-for="Status" asp-items="Model.ReEmploymentStatus" onchange="this.form.submit()" class="form-select sub-selector">
                                            <option value="">-- انتخاب وضعیت --</option>
                                        </select>
                                    </form>
                                </td>
                            }

                            <td class="text-end pe-1">

                                <button class="table-action">
                                    <a asp-page="Details" asp-route-id="@item.Id">

                                        <i class="bi bi-eye"></i>

                                    </a>
                                </button>
                                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">ویرایش</a>

                            </td>
                        </tr>
                        counter++;
                    }
                </tbody>
            </table>
        </div>
    </div>
    <partial name="_Pagination" model="Model.Search" />
</div>
<script src="~/js/timeout_for_alert.js"></script>
